# ─────────────────────────────────────────────────────────────────────────────
# Compose 级别环境变量模板（复制为 .env 后填真实值：cp .env.example .env）
# 注意：.env 含密钥，已被根目录 .gitignore 忽略，绝不入库。
# 变量被 docker-compose.yml 通过 ${...} 插值引用。
# ─────────────────────────────────────────────────────────────────────────────

# ── 数据库（PostgreSQL，由本 Compose 的 postgres 服务提供，官方镜像）──
# 首次启动时 postgres 服务按以下变量自动建库 / 建用户；后续改此处不影响已建库。
PG_USER=postgres
PG_PASSWORD=change_me_strong_password
PG_DB=songdian_b2b

# ── 后端 JWT 密钥（≥32 字节随机值；与 admin-next 共用，必须一致）──
# 生成：python -c "import secrets;print(secrets.token_urlsafe(32))"
JWT_SECRET=change_me_generate_with_secrets_token_urlsafe_32

# ── 后台发布后刷新官网 ISR 缓存的内部密钥（≥32 字节随机值）──
REVALIDATE_SECRET=change_me_generate_another_random_secret

# ── 初始管理员密码（首次部署时由最小种子创建 admin；必须使用强随机密码）──
ADMIN_PASSWORD=change_me_admin_password

# ── 首次部署临时设为 true，完成角色/权限/admin 初始化后立即改回 false。
#     不要将 db/ 下的开发 SQL/CSV 快照导入生产。──
SEED_ON_START=false
# 仅本地演示时可设为 true；生产始终保持 false，避免写入演示分类。
SEED_CONTENT_CATEGORIES=false

# ── CORS 允许的来源（Cookie 会话只允许 HTTPS 官网 + 后台域名，禁用通配）──
CORS_ORIGINS=https://www.zsaki.icu,https://admin.zsaki.icu

# OpenResty 位于宿主机、backend 位于 Docker 时可留空，容器会自动识别 Docker 网桥网关。
# 仅在自定义反代拓扑下填可信代理 IP（逗号分隔），绝不能设为 *。
TRUSTED_PROXIES=

# ── 前端公开 API 地址（浏览器可达，走 OpenResty 反代 → backend:8000）──
NEXT_PUBLIC_API_URL=https://api.zsaki.icu

# ── 官网规范地址（SEO canonical / sitemap / robots，构建期内联）──
NEXT_PUBLIC_SITE_URL=https://www.zsaki.icu

# ── Next.js 图片优化允许的 API/上传文件主机（只填主机名，不带协议）──
NEXT_PUBLIC_IMAGE_HOST=api.zsaki.icu

# 注：DATABASE_URL / REDIS_URL 由 compose 按服务名自动拼接（postgres / redis），无需在此配置。
