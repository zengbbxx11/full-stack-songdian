# ─────────────────────────────────────────────────────────────────────────────
# Compose 级别环境变量模板（复制为 .env 后填真实值：cp .env.example .env）
# 注意：.env 含密钥，已被根目录 .gitignore 忽略，绝不入库。
# 变量被 docker-compose.yml 通过 ${...} 插值引用。
# ─────────────────────────────────────────────────────────────────────────────

# ── 数据库（PostgreSQL，由本 Compose 的 postgres 服务提供，官方镜像）──
# 首次启动时 postgres 服务按以下变量自动建库 / 建用户；后续改此处不影响已建库。
PG_USER=postgres
PG_PASSWORD=change_me_strong_password
PG_DB=songdian_b2b

# ── 后端 JWT 密钥（≥32 字节随机值；与 admin-next 共用，必须一致）──
# 生成：python -c "import secrets;print(secrets.token_urlsafe(32))"
JWT_SECRET=change_me_generate_with_secrets_token_urlsafe_32

# ── 初始管理员密码（仅在 SEED_ON_START=true 时由应用种子器使用；
#     若按「六、导入数据」导入 seed_data.sql，则管理员账号已随数据入库，此值无效）──
ADMIN_PASSWORD=change_me_admin_password

# ── 是否启动即导入种子数据（true=冷启动演示数据；false=手动导入 seed_data.sql）──
SEED_ON_START=false

# ── CORS 允许的来源（官网 + 后台公网域名，逗号分隔；禁用通配）──
# 有域名时（HTTPS）：
# CORS_ORIGINS=https://www.songdian.tech,https://admin.songdian.tech
# 仅有 IP 时（HTTP）：
CORS_ORIGINS=http://106.53.220.184,http://106.53.220.184:8081

# ── 前端公开 API 地址（浏览器可达，走 OpenResty 反代 → backend:8000）──
# 有域名时：NEXT_PUBLIC_API_URL=https://api.songdian.tech
# 仅有 IP 时（路径反代 /api → backend）：
NEXT_PUBLIC_API_URL=http://106.53.220.184

# ── 官网规范地址（SEO canonical / sitemap / robots，构建期内联）──
# 有域名时：NEXT_PUBLIC_SITE_URL=https://www.songdian.tech
NEXT_PUBLIC_SITE_URL=http://106.53.220.184

# ── Next.js 图片优化允许的 API/上传文件主机（只填主机名，不带协议）──
# 有域名时：NEXT_PUBLIC_IMAGE_HOST=api.songdian.tech
NEXT_PUBLIC_IMAGE_HOST=106.53.220.184

# 注：DATABASE_URL / REDIS_URL 由 compose 按服务名自动拼接（postgres / redis），无需在此配置。
