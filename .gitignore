# Python
__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.pytest_cache/

# Environment / secrets
.env

# Local databases
*.db
*.db-shm
*.db-wal
dev.db

# IDE
.idea/

# CodeBuddy 本地项目数据（会话计划 plans/、本机设置 settings.local.json），保留在本地，不上传仓库
.codebuddy/

# Local uploads backup (large binary assets, excluded)
uploads_bak_*/

# Large video assets are excluded by default; the About-page factory tour is
# intentionally versioned so CI-built frontend images contain it.
frontend/public/Video/*
!frontend/public/Video/SongdianFactoryVideo.mp4
!frontend/public/Video/factory-poster.webp

# Temp diagnostics
diag*.txt
ruff_out.txt
.deploy/

# Next.js build cache
.next/
playwright-report/
test-results/
.lighthouseci/
# Local runtime logs
runtime-logs/

# Verification screenshots under reports/ (large binaries, regenerable locally).
# Report text (reports/*.md, *.json) stays versioned — it is the historical convention here.
reports/**/*.png
reports/**/*.jpg
reports/**/*.jpeg
reports/**/*.webp

# Disposable backend integration databases and local verification scripts
.qa/
