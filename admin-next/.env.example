# ─────────────────────────────────────────────────────────────────────────────
# 管理后台环境变量模板（admin-next/.env.example）
# 复制为 .env.local 后填入：cp .env.example .env.local
# 注意：本文件可安全提交；.env.local 被 .gitignore 忽略，绝不入库。
# ─────────────────────────────────────────────────────────────────────────────

# 后端 API 地址（客户端组件读取，须用 NEXT_PUBLIC_ 前缀）。
NEXT_PUBLIC_API_URL=http://localhost:8000

# Next.js 服务端 rewrites 的后端目标。本地可省略（默认 localhost:8000）；
# Docker Compose 必须使用服务名，不能使用腾讯云公网 IP。
BACKEND_PROXY_URL=http://localhost:8000

# 云端无域名部署时，公网地址为：
# NEXT_PUBLIC_API_URL=http://106.53.220.184
# 后续独立 API 域名：NEXT_PUBLIC_API_URL=https://api.songdian.tech
# Docker Compose 内部代理仍使用 BACKEND_PROXY_URL=http://backend:8000，勿改成公网 IP。

# JWT 签名密钥（服务端中间件读取，用于校验 admin_token 的 HS256 签名，review #13）。
# 必须与后端 .env 的 JWT_SECRET 完全一致！生成：python -c "import secrets;print(secrets.token_urlsafe(32))"
# ⚠️ 切勿加 NEXT_PUBLIC_ 前缀，否则密钥会泄露到浏览器端！
JWT_SECRET=
