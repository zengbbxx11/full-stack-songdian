# ─────────────────────────────────────────────────────────────────────────────
# 后端环境变量模板（backend/.env.example）
# 复制本文件为 .env 后填入真实值：cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，绝不入库；本模板可安全提交。
# 配置项与设计文档 §4.3 及 common/config.py 的 Settings 字段逐一对齐。
# ─────────────────────────────────────────────────────────────────────────────

# ── 数据库 ──
# PostgreSQL 示例：postgres://user:pass@localhost:5432/songdianB2B
# 注意：Tortoise-ORM 只认 postgres://（asyncpg 驱动），写成 postgresql://
#      会在启动时报 "Unknown DB scheme: postgresql"（与 docker-compose.yml 一致）。
# 本地开发可切 SQLite：sqlite://./dev.db（会自动建表）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/songdianB2B

# Redis（留空或连不上 → 内存降级，不阻断启动）
REDIS_URL=redis://127.0.0.1:6379/0

# ── 缓存键环境前缀（security-audit F-18：多环境共用同一 Redis 时避免串号）──
# 留空=不加前缀；如 "songdian:prod"，则所有缓存键变为 "songdian:prod:..." 
CACHE_KEY_PREFIX=

# ── JWT ──
# 生产环境必须注入 ≥32 字节随机值：python -c "import secrets;print(secrets.token_urlsafe(32))"
# 留空时：开发环境自动生成临时密钥（重启失效）；生产环境直接拒绝启动（F-13 启动守卫）。
JWT_SECRET=
JWT_ALG=HS256
ACCESS_TOKEN_TTL=7200
REFRESH_TOKEN_TTL=604800

# ── 运行环境 ──
# development 允许 HTTP 本地 Cookie；生产必须设为 production，并使用 HTTPS 域名。
APP_ENV=development
OPENAPI_DOCS_ENABLED=false

# ── SMTP 询盘邮件（留空 → 询盘仅入库不发信）──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
INQUIRY_EMAIL_FROM=
INQUIRY_EMAIL_TO=

# ── 限流阈值 ──
RATE_GLOBAL_QPS=500
RATE_IP_QPS=60
RATE_USER_QPS=30
RATE_LOGIN_PER_MIN=10

# ── CORS（显式来源，Cookie 会话需要 allow_credentials，禁用通配）──
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── 受信代理（仅这些直连 IP 的 X-Forwarded-For 才被信任；逗号分隔，留空=全不信任）──
TRUSTED_PROXIES=127.0.0.1

# ── 安全失败策略（Redis 不可用时安全关键操作 fail-closed）──
SECURITY_FAIL_CLOSED=true

# ── 种子数据 ──
SEED_ON_START=true
# 生产保持 false；启用时只创建角色、权限和管理员，不会改动已有内容。
SEED_CONTENT_CATEGORIES=false
# 初始管理员密码：留空则种子生成一次性随机密码并打印到日志（F-04 不硬编码默认值）。
ADMIN_PASSWORD=

# ── ISR 按需刷新（发布/撤回/到期后由后端通知官网 /api/revalidate 清缓存）──
# 留空 = 不发通知，官网页面与 sitemap 会滞后到下一个缓存周期（本地开发易误判为"数据没更新"）。
# 本地开发：http://127.0.0.1:3000/api/revalidate
#   注意用 127.0.0.1 而非 localhost：httpx 默认 trust_env=True，在配置了系统代理的机器上
#   localhost 会被劫持并返回 502（后端只能不断重试退避，官网缓存迟迟不刷新）。
# Docker Compose：http://frontend:3000/api/revalidate（见 docker-compose.yml）
NEXT_REVALIDATE_URL=http://127.0.0.1:3000/api/revalidate
# 必须与 frontend 的 REVALIDATE_SECRET 完全一致，否则官网返回 401、缓存不会被清除。
REVALIDATE_SECRET=change_me_generate_another_random_secret

# ── 服务监听 ──
HOST=0.0.0.0
PORT=8000

# ── 媒体文件 ──
MEDIA_ROOT=uploads
MEDIA_URL=/uploads

# ── 文件上传配额（防磁盘耗尽 DoS）──
MAX_UPLOAD_MB=10
MAX_UPLOAD_FILES=20
MAX_UPLOAD_TOTAL_MB=100
STORAGE_BACKEND=local
