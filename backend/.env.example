# ─────────────────────────────────────────────────────────────────────────────
# 后端环境变量模板（backend/.env.example）
# 复制本文件为 .env 后填入真实值：cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，绝不入库；本模板可安全提交。
# 配置项与设计文档 §4.3 及 common/config.py 的 Settings 字段逐一对齐。
# ─────────────────────────────────────────────────────────────────────────────

# ── 数据库 ──
# PostgreSQL 示例：postgresql://user:pass@localhost:5432/songdianB2B
# 本地开发可切 SQLite：sqlite://./dev.db（会自动建表）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/songdianB2B

# Redis（留空或连不上 → 内存降级，不阻断启动）
REDIS_URL=redis://127.0.0.1:6379/0

# ── JWT ──
# 生产环境必须注入 ≥32 字节随机值：python -c "import secrets;print(secrets.token_urlsafe(32))"
# 留空时：开发环境自动生成临时密钥（重启失效）；生产环境直接拒绝启动（F-13 启动守卫）。
JWT_SECRET=
JWT_ALG=HS256
ACCESS_TOKEN_TTL=7200
REFRESH_TOKEN_TTL=604800

# ── 运行环境 ──
# development 放开 /docs；production 缺失 JWT_SECRET 直接拒绝启动并默认关闭文档（F-13/F-14）。
APP_ENV=production
OPENAPI_DOCS_ENABLED=false

# ── SMTP 询盘邮件（留空 → 询盘仅入库不发信）──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
INQUIRY_EMAIL_FROM=
INQUIRY_EMAIL_TO=

# ── 限流阈值 ──
RATE_GLOBAL_QPS=500
RATE_IP_QPS=60
RATE_USER_QPS=30
RATE_LOGIN_PER_MIN=10

# ── CORS（显式来源，逗号分隔；Bearer 鉴权无需凭据，禁用通配）──
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── 受信代理（仅这些直连 IP 的 X-Forwarded-For 才被信任；逗号分隔，留空=全不信任）──
TRUSTED_PROXIES=127.0.0.1

# ── 安全失败策略（Redis 不可用时安全关键操作 fail-closed）──
SECURITY_FAIL_CLOSED=true

# ── 种子数据 ──
SEED_ON_START=true
# 初始管理员密码：留空则种子生成一次性随机密码并打印到日志（F-04 不硬编码默认值）。
ADMIN_PASSWORD=

# ── 服务监听 ──
HOST=0.0.0.0
PORT=8000

# ── 媒体文件 ──
MEDIA_ROOT=uploads
MEDIA_URL=/uploads

# ── 文件上传配额（防磁盘耗尽 DoS）──
MAX_UPLOAD_MB=10
MAX_UPLOAD_FILES=20
MAX_UPLOAD_TOTAL_MB=100
STORAGE_BACKEND=local
