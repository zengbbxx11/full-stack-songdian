# ─────────────────────────────────────────────────────────────
# 松典 B2B 后端 · 环境变量样例（复制为 .env 后按需修改）
# 本文件不含任何真实密钥；生产密钥经 1Panel 保密文件挂载（L4）。
# ─────────────────────────────────────────────────────────────

# 数据库（开发和生产统一使用 PostgreSQL）
DATABASE_URL=postgres://songdian:songdian@pg:5432/songdian_b2b

# Redis（未配置或连不上会自动降级为内存字典，绝不阻断启动）
REDIS_URL=redis://redis:6379/0
# 本地无 Redis 时留空：REDIS_URL=

# JWT（L4：生产用 1Panel 保密文件挂载，不进仓库）
# 注意（security-audit F-13）：
# - 绝不要提交真实密钥；本文件仅为样例，JWT_SECRET 必须替换为 ≥32 字节随机值。
# - 定期轮换 JWT_SECRET；轮换会使旧令牌失效，属预期行为。
# - 本占位符仅作示例，生产环境若未替换将被启动守卫拒绝（见 common/config.py）。
JWT_SECRET=change-me-strong-random
JWT_ALG=HS256
ACCESS_TOKEN_TTL=7200        # 2h（秒）
REFRESH_TOKEN_TTL=604800     # 7d（秒）

# SMTP（未配置则询盘仅持久化，BD-02/MOCK）
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
INQUIRY_EMAIL_FROM=
INQUIRY_EMAIL_TO=

# 限流（§3.5.3，可被配置中心覆盖）
RATE_GLOBAL_QPS=500
RATE_IP_QPS=60
RATE_USER_QPS=30
RATE_LOGIN_PER_MIN=10

# 单租户常量
TENANT_ID=songdian

# 首次部署是否由应用启动时幂等写入种子数据
SEED_ON_START=true

# 服务监听
HOST=0.0.0.0
PORT=8000
