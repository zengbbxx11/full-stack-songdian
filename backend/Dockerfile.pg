# PostgreSQL 16 + zhparser 中文分词扩展（生产/本地）
FROM postgres:16

# 安装 zhparser 构建依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    postgresql-server-dev-16 \
    wget \
    && rm -rf /var/lib/apt/lists/*

# 编译安装 zhparser（PG 扩展，非 Python 包）
RUN wget -O zhparser.tar.gz https://github.com/amutu/zhparser/archive/refs/tags/v2.2.tar.gz \
    && tar -xzf zhparser.tar.gz \
    && cd zhparser-2.2 \
    && make && make install \
    && cd / && rm -rf zhparser-2.2 zhparser.tar.gz

# 初始化脚本：创建 zh 文本检索配置
COPY docker/init-zh.sh /docker-entrypoint-initdb.d/001-init-zh.sh
RUN chmod +x /docker-entrypoint-initdb.d/001-init-zh.sh
