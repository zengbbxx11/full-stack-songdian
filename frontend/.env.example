# ============================================================
# FastAPI 后端 API 地址
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
# 云端无域名部署时使用根目录 .env 中的：
# NEXT_PUBLIC_API_URL=http://106.53.220.184

# Next.js 图片优化允许的后端图片主机（只填主机名，不带协议/路径）
# 当前腾讯云无域名部署：106.53.220.184
# 后续使用独立 API 域名时：NEXT_PUBLIC_IMAGE_HOST=api.songdian.tech
NEXT_PUBLIC_IMAGE_HOST=106.53.220.184

# ============================================================
# Google Analytics GA4（格式: G-XXXXXXXXXX）
# 不填则不加载 GA 脚本
# ============================================================
NEXT_PUBLIC_GA_ID=

# ============================================================
# Google Search Console 验证码
# ============================================================
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# ============================================================
# ISR Revalidation (seconds)
# ============================================================
NEXT_PUBLIC_ISR_REVALIDATE=60

# ============================================================
# Site Info
# ============================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 当前生产：http://106.53.220.184
# 后续域名：https://www.songdian.tech
NEXT_PUBLIC_SITE_NAME=Songdian Technology — Digital Camera OEM/ODM Manufacturer
NEXT_PUBLIC_SITE_DESCRIPTION=Songdian Technology (松典) — 19 years of digital camera manufacturing. 30+ new products/year, 8,000 units daily output, 500+ patents. OEM/ODM partner for global brands.

# 询盘由 FastAPI 保存至 PostgreSQL 并负责 SMTP 通知；SMTP 请在管理后台
# “系统设置”中配置，backend/.env 的 SMTP_* 仅作为后端兜底。
