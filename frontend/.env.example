# ============================================================
# FastAPI 后端 API 地址
# ============================================================
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# 生产环境：NEXT_PUBLIC_API_URL=https://api.zsaki.icu

# Server Components / 构建阶段访问后端的内部地址；本地开发与公开地址一致
INTERNAL_API_URL=http://127.0.0.1:8000

# Next.js 图片优化允许的后端图片主机（只填主机名，不带协议/路径）
# 生产环境使用独立 API 域名（仅主机名，不带协议）
NEXT_PUBLIC_IMAGE_HOST=api.zsaki.icu

# 仅限本地开发：允许 next/image 取 localhost / 127.0.0.1 / 局域网后端图片。
# 生产环境必须保持 false 或不设置（放开会扩大服务端取图范围，属 SSRF 面）。
#
# 注意：本模板的 NEXT_PUBLIC_API_URL 指向 127.0.0.1:8000，属于本地后端。
# 若保持 false，官网所有产品图/新闻图都会被图片优化器拒绝
# （/_next/image 返回 400 "url" parameter is not allowed），页面表现为图片空白。
# 因此本地开发请把它改成 true（改完需重启 Next.js）。
ALLOW_LOCAL_IMAGE_OPTIMIZATION=false

# ============================================================
# Google Analytics GA4（格式: G-XXXXXXXXXX）
# 不填则不加载 GA 脚本
# ============================================================
NEXT_PUBLIC_GA_ID=

# ============================================================
# Google Search Console 验证码
# ============================================================
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# ============================================================
# ISR 按需刷新密钥（与后端共享）
# ============================================================
# 后端在内容发布/恢复/到期后调用官网 /api/revalidate 清理 ISR 缓存时校验此密钥。
# 本地开发必须与后端 .env 的 REVALIDATE_SECRET 一致，否则官网请求恒返回 401，
# 发布内容不会即时刷新（生产由 docker-compose 从根 .env 注入）。
REVALIDATE_SECRET=change_me_generate_another_random_secret

# ============================================================
# Site Info
# ============================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 生产环境：https://www.zsaki.icu
NEXT_PUBLIC_SITE_DESCRIPTION=Songdian Technology (松典) — 19 years of digital camera manufacturing. 30+ new products/year, 8,000 units daily output, 500+ patents. OEM/ODM partner for global brands.

# 询盘由 FastAPI 保存至 PostgreSQL 并负责 SMTP 通知；SMTP 请在管理后台
# “系统设置”中配置，backend/.env 的 SMTP_* 仅作为后端兜底。
