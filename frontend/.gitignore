# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# customer data (inquiries, leads — never commit)
data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Large video assets are excluded by default. Keep the About-page factory tour
# in Git because production images are built from a clean CI checkout.
/public/Video/*
!/public/Video/SongdianFactoryVideo.mp4
!/public/Video/factory-poster.webp
