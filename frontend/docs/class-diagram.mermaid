classDiagram
    class api_client {
        +API_BASE: string
        +INTERNAL_API_URL: string
        +apiFetch(path, params, options): Promise~T~
        +toAbsoluteUrl(path): string|null
    }
    class ApiError { +status: number|null; +code: string|null; +path: string; +cause: unknown }
    class products_api {
        +getProducts(params): ProductPage
        +getProductBySlug(slug): ProductDetail|null
        +getProductCategories(): Category[]
        +getAllProductSlugEntries(): ProductSlugEntry[]
    }
    class ProductDetailPage { +notFound(); +ProductUnavailable(); +generateMetadata() }
    class PreviewPage { +validateSignedToken(); +noindex; +no-store }
    class WebVitalsReporter { +reportWebVitals(metric); +requiresAnalyticsConsent }
    class ProductSummary { +slug; +name; +image; +categories; +stockStatus }
    class ProductDetail { +description; +gallery; +attributes; +seoTitle; +seoDescription }

    api_client --> ApiError : throws
    products_api --> api_client : uses
    ProductDetailPage --> products_api : loads
    ProductDetailPage --> ApiError : distinguishes outage
    ProductSummary <|-- ProductDetail
    PreviewPage --> api_client : signed preview fetch
    WebVitalsReporter --> api_client : consent-gated telemetry
